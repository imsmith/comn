// As-built components of the Secrets container.

model {
    extend comnab.secrets {

        secretsbehaviour = component {
            title 'Comn.Secrets'
            description 'Behaviour for secret locking/unlocking implementations, with a use macro that injects @behaviour Comn.Secrets into backends. Implements @behaviour Comn.'
            technology 'Elixir behaviour + macro'
        }

        secretstop = component {
            title 'Secrets'
            description 'Eight-line top-level convenience module that points at Comn.Secrets. lib/secrets.ex.'
            technology 'Elixir module'
        }

        secretprotocol = component {
            title 'Comn.Secret'
            description 'Protocol converting Elixir terms to and from binary blobs so any type can be locked or unlocked.'
            technology 'Elixir protocol'
        }

        secretslocal = component {
            title 'Comn.Secrets.Local'
            description 'Local backend using Erlang :crypto — Ed25519 keys for identity, ChaCha20-Poly1305 for AEAD encryption. Implements Comn.Secrets and Comn.'
            technology 'Erlang :crypto'
        }

        secretsvault = component {
            title 'Comn.Secrets.Vault'
            description 'HashiCorp Vault Transit backend. Delegates all encryption to Vault; the application never holds key material. Implements Comn.Secrets and Comn.'
            technology 'Vault Transit HTTP API over Req'
        }

        secretskey = component {
            title 'Comn.Secrets.Key'
            description 'Symmetric or asymmetric key pair used to lock and unlock secrets.'
            technology 'Elixir struct'
        }

        lockedblob = component {
            title 'Comn.Secrets.LockedBlob'
            description 'Encrypted data blob — the result of lock/2 on a binary or wrap/2 on a key.'
            technology 'Elixir struct'
        }

        secretscontainer = component {
            title 'Comn.Secrets.Container'
            description 'Groups multiple LockedBlobs together.'
            technology 'Elixir struct'
        }

        secretserrors = component {
            title 'Comn.Secrets.Errors'
            description 'Registered error codes for the secrets subsystem.'
            technology 'Elixir macro registration'
        }

        secretstop -[ipc]-> secretsbehaviour 'Delegates to'
        secretslocal -[ipc]-> secretsbehaviour 'Implements'
        secretsvault -[ipc]-> secretsbehaviour 'Implements'
        secretsbehaviour -[ipc]-> secretprotocol 'Serialises terms through'
        secretslocal -[ipc]-> secretskey 'Generates and consumes'
        secretslocal -[ipc]-> lockedblob 'Produces'
        secretsvault -[ipc]-> lockedblob 'Produces'
        secretscontainer -[ipc]-> lockedblob 'Groups'
        secretsbehaviour -[ipc]-> secretserrors 'Raises codes registered by'
    }

    comnab.secrets.secretsvault -[rpc]-> vaultserver 'Transit encrypt / decrypt'
}

views {

    view asbuilt_secrets of comnab.secrets {
        title 'Comn Secrets — Components (as-built)'
        description 'Two backends behind one behaviour, plus the term/blob protocol and the key, blob and container structs. The hand-written comn.c4 models Secrets as an empty container.'

        include *, vaultserver
    }
}
